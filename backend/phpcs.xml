<?xml version="1.0"?>
<ruleset name="AFPL">
    <description>Diáksorsoló kódformázási szabályok (PSR-12)</description>

    <file>src</file>
    <file>public</file>
    <file>tests</file>
    <file>database</file>

    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12">
        <!-- Windowson és Linuxon is dolgozunk, a sorvég típusát nem ellenőrizzük. -->
        <exclude name="Generic.Files.LineEndings"/>
        <!-- A migrate.php egyszerre függvényeket definiál és CLI-ből futtatható. -->
        <exclude name="PSR1.Files.SideEffects"/>
    </rule>

    <!-- A tesztosztályok névtér nélküliek (PHPUnit a tests mappából tölti be őket). -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>

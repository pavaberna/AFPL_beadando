{
    "name": "pavaberna/afpl-beadando",
    "description": "Diáksorsoló - AFPL beadandó",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.3"
    },
    "scripts": {
        "test": "phpunit tests",
        "lint": "phpstan analyse --no-progress --memory-limit=256M",
        "format": "phpcs",
        "format:fix": "phpcbf",
        "migrate": "php database/migrate.php"
    }
}

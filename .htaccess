# Az ErrorDocument csak a teljes útvonal megadásával működik 
# Helyben:       http://localhost/AFPL_beadando/
# Teszteléskor:  http://localhost:8080/AFPL_beadando/

ErrorDocument 404 /AFPL_beadando/frontend/404.html

RewriteEngine On

# Kezdőoldal
RewriteRule ^$ frontend/index.html [END]

# HTML-oldalak
RewriteRule ^(index|admin|tanar)\.html$ frontend/$1.html [END]

# A frontendhez tartozó fájlok
RewriteRule ^(css|js|img|partials)/(.*)$ frontend/$1/$2 [END]